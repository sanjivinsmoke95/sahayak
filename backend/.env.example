# ----- Database -----
DATABASE_URL=postgresql+asyncpg://sahayak:sahayak@localhost:5432/sahayak

# ----- Application -----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ----- Clerk -----
# Leave blank to run without authentication during early development.
# Find the issuer on your Clerk dashboard, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_AUDIENCE=

# ----- Supabase Storage -----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sahayak-documents

# ----- Government Data Collector -----
# Base URL of the standalone sahayak-collector service (crawls gov portals and
# exposes /search). Leave blank to disable the /services endpoints.
COLLECTOR_API_URL=http://localhost:8010
COLLECTOR_TIMEOUT=10

# ----- Google Maps (Mee Seva centre finder) -----
# Server-side key: used to search nearby centres. Never sent to the browser.
# Enable "Places API" for this key.
GOOGLE_MAPS_API_KEY=
# Optional browser key for the interactive map. Enable "Maps JavaScript API"
# and restrict it by HTTP referrer to your site. Leave blank for a list view.
GOOGLE_MAPS_BROWSER_KEY=

# ----- AI providers -----
# Whichever keys are present become selectable models. With none set the
# rule-based engine answers, which is enough to develop against.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AI_PROVIDER=rule-based

# ----- Government interoperability (SIH26129) -----
# The interoperability layer lets a citizen change their address or phone once
# and propagate it, with consent, to five simulated government systems.
INTEROP_ENABLED=true
# Where the connectors reach the mock government systems. Defaults to this same
# backend's /api, so one running server serves both the citizen app and the
# five mock departments. Point it elsewhere to host the mocks separately.
MOCK_GOV_BASE_URL=http://localhost:8000/api
# Optional shared secret presented by the connectors to the mock systems
# (models system-to-system auth). Blank leaves the mock endpoints open locally.
MOCK_GOV_API_KEY=
# Optional data.gov.in key for reference lookups only (e.g. pincode -> city).
# The interoperability demo works fully without it; it is never required.
DATA_GOV_API_KEY=

# ----- Identity encryption (Aadhaar / PAN) -----
# Required before Aadhaar or PAN can be stored. Without it the identity
# endpoints return 503 — the app never falls back to storing plaintext.
#
# Generate a key:
#   python -c "from app.services.identity_crypto import generate_key; print(generate_key())"
#
# Comma-separated, versioned, so keys can be rotated without downtime: add the
# new version here, point ACTIVE at it, then re-save each record to re-seal it.
# Keep the old key until nothing references it. Never commit real keys.
IDENTITY_ENCRYPTION_KEYS=
# Which version seals new writes, e.g. v1. Defaults to the highest present.
IDENTITY_ENCRYPTION_ACTIVE_VERSION=v1
