# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sahayak
POSTGRES_USER=sahayak
POSTGRES_PASSWORD=change_me

# ---- Crawler behaviour ----
CRAWL_CONCURRENCY=8
CONCURRENT_PER_DOMAIN=2
DOWNLOAD_DELAY=1.0
CRAWL_MAX_DEPTH=2
AUTOTHROTTLE_ENABLED=true
# Keep enabled unless you have written permission from the relevant portal.
RESPECT_ROBOTS_TXT=true
USER_AGENT=SahayakBot/1.0 (+https://example.org/sahayak; contact=admin@example.org)

# ---- Playwright (JS rendering) ----
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=30000

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Search ----
DEFAULT_SEARCH_MODE=hybrid
HYBRID_SEMANTIC_WEIGHT=0.6

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8010
LOG_LEVEL=INFO

# ---- Scheduler ----
REFRESH_CRON=0 3 * * *
