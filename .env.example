# Root environment file for docker compose.
# Copy this to `.env` (same folder as docker-compose.yml) and fill in values.
# `.env` is gitignored — never commit real keys.

# ----- Google Maps (Mee Seva centre finder) -----
# SERVER key: used by the backend to search for nearby centres. It never
# reaches the browser. In Google Cloud Console, enable the "Places API" for it.
GOOGLE_MAPS_API_KEY=

# BROWSER key (optional): draws the interactive map in the page. Enable the
# "Maps JavaScript API" for it and RESTRICT it by HTTP referrer to your site
# (e.g. http://localhost:3000/*). Leave blank to use the list-only view.
GOOGLE_MAPS_BROWSER_KEY=

# ----- AI provider (optional) -----
# With no key the app uses the built-in rule-based engine. Add one for richer,
# document-specific explanations, and set DEFAULT_AI_PROVIDER to match.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AI_PROVIDER=rule-based
