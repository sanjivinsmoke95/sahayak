# ----- Backend -----
# Server-side only. The Next.js `/api` rewrite (next.config.mjs) forwards to it.
BACKEND_URL=http://localhost:8000

# Document API, exposed to the browser. Leave as /api to go through the rewrite.
NEXT_PUBLIC_API_URL=/api

# ----- Government data API -----
# The gov Axios layer (lib/api) also goes through the SAME /api rewrite to the
# main backend, which proxies to the collector. Keep as /api so the flow stays
# frontend → main backend → collector (no direct browser→collector, no CORS).
NEXT_PUBLIC_API_BASE_URL=/api

# Set to true only when the separate Government Data Collector is running.
# The main application works without it.
NEXT_PUBLIC_ENABLE_GOV_SERVICE_STATUS=false

# ----- Clerk authentication -----
# Get these from https://dashboard.clerk.com
# Leave both blank to run the app without sign-in during early development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
