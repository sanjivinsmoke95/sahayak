{
  "name": "SAHAYAK — Government information, made simple",
  "short_name": "Sahayak",
  "description": "Explains government documents in plain language, finds your deadlines, and shrinks your files so they can actually be uploaded.",
  "start_url": "/",
  "scope": "/",
  "id": "/sahayak/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#1B4B8F",
  "theme_color": "#1B4B8F",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["government", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Make a file smaller",
      "short_name": "Shrink",
      "url": "/shrink",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Scan a document",
      "short_name": "Scan",
      "url": "/upload",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
